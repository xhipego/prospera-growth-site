# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# QUOTE_RECIPIENT_EMAIL: Destination inbox for website quote requests.
QUOTE_RECIPIENT_EMAIL=thulo@prosperagrowth.co.za

# Option 1: Resend API (recommended for transactional quote emails)
RESEND_API_KEY=
RESEND_FROM=

# Option 2: Domain SMTP (e.g., mail.prosperagrowth.co.za, Microsoft 365, or Google Workspace)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
